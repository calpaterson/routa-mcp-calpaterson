{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(~/.routa/**)",
      "Edit(~/.routa/**)",
      "Bash(*.routa*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.ts\""
          }
        ]
      }
    ]
  }
}
